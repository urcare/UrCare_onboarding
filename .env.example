# ---- Server ----
PORT=3000
# Public address of this site (used in share links). Leave empty to auto-detect.
PUBLIC_URL=

# ---- Who receives the PDF on WhatsApp ----
# Admin / doctor WhatsApp number(s) with country code. Separate several with commas.
ADMIN_WHATSAPP=919876543210
# Also send a copy to the employee's own WhatsApp number (true / false)
SEND_TO_EMPLOYEE=true

# ---- WhatsApp Cloud API (Meta) ----
# From developers.facebook.com > your app > WhatsApp > API Setup
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v25.0

# Approved template with a DOCUMENT header (needed to message people who have not
# messaged your business number in the last 24 hours). Leave empty to send a plain document.
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en
# true if the template body has one variable {{1}} for the employee's name
WA_TEMPLATE_BODY_HAS_NAME=true

# ---- Email to admin (Gmail) ----
# Admin email(s) that receive the PDF. Separate several with commas.
ADMIN_EMAIL=admin@gmail.com
# Gmail account that sends the email + its 16-letter App Password
# (Google Account > Security > 2-Step Verification > App passwords)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM_NAME=UrCare Onboarding
# Also email a copy to the employee (true / false)
EMAIL_TO_EMPLOYEE=false

# ---- Marksheet auto-read (Groq) ----
# From console.groq.com > API Keys. When set, uploaded 10th / 12th / graduation marksheets
# are read automatically and "Your qualifications" is filled in for the employee.
GROQ_API_KEY=
# Vision model to use (change only if Groq retires this one)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Storage ----
STORAGE_DIR=storage
# Delete stored PDFs after this many days (0 = keep forever)
DELETE_AFTER_DAYS=0
